---
import '../styles/global.css';

const siteModules = import.meta.glob('../../content/pages/site.md', { eager: true });
const siteEntry = Object.values(siteModules)[0] ?? {};
const siteData = siteEntry.frontmatter ?? {};

const brand = siteData.brand ?? 'What I Think';
const siteDescription = siteData.description ?? 'Thinking Log by psytor-log';
const menu = siteData.menu ?? {};
const footer = siteData.footer ?? {};

const {
  title = brand,
  description = siteDescription,
  current = '',
  robots = '',
  ogType = 'website',
  image = '',
  publishedTime = ''
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
// cover 가 있으면 그 이미지, 없으면 사이트 기본 대표 카드(og-default.png)로 폴백.
const ogImage = new URL(image || '/og-default.png', Astro.site).href;

const nav = [
  [menu.home ?? 'Home', '/', 'home'],
  [menu.essay ?? 'Essay', '/essay/', 'essay'],
  [menu.study ?? 'Study', '/study/', 'study'],
  [menu.books ?? 'Books', '/books/', 'books'],
  [menu.portfolio ?? 'Portfolio', '/portfolio/', 'portfolio'],
  [menu.ichnos ?? 'Vestigo', '/ichnos/', 'ichnos'],
  [menu.about ?? 'About', '/about/', 'about']
];

const footerBrand = footer.brand ?? brand;
const footerTagline = footer.tagline ?? '';
const adminLabel = footer.admin_label ?? '/admin/';
const todayLabel = footer.today_label ?? 'Today';
const totalLabel = footer.total_label ?? 'Total';
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fbfbfc" />
    {robots && <meta name="robots" content={robots} />}
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={brand} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}

    <!-- Twitter -->
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable.min.css"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Serif+KR:wght@500;600;700&family=Public+Sans:wght@400;500;600;700&family=Source+Serif+Pro:wght@400;600;700&display=swap"
    />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">본문으로 건너뛰기</a>
    <header class="site-header">
      <nav class="nav" aria-label="Main navigation">
        <a class="brand" href="/">{brand}</a>
        <div class="menu">
          {nav.map(([label, href, key]) => (
            <a
              href={href}
              class={current === key ? 'active' : ''}
              aria-current={current === key ? 'page' : undefined}
            >{label}</a>
          ))}
        </div>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="footer">
      <div class="footer-inner">
        <div class="footer-brand">
          <strong>{footerBrand}</strong>
          {footerTagline && <span>{footerTagline}</span>}
        </div>
        <div class="footer-meta">
          <a class="admin-link" href="/admin/" rel="nofollow">{adminLabel}</a>
          <div class="stat">
            <span class="label">{todayLabel}</span>
            <span class="value" id="visitor-today">—</span>
          </div>
          <div class="stat">
            <span class="label">{totalLabel}</span>
            <span class="value" id="visitor-total">—</span>
          </div>
        </div>
      </div>
    </footer>
    <script is:inline>
      window.WIT_ANALYTICS_ENDPOINT =
        "https://psytor-log-decap-oauth.dejangbu.workers.dev/hit";
    </script>
    <script is:inline>
      (function () {
        var endpoint = window.WIT_ANALYTICS_ENDPOINT;
        if (!endpoint) return;
        fetch(endpoint, { credentials: 'omit' })
          .then(function (r) { return r.ok ? r.json() : null; })
          .then(function (data) {
            if (!data) return;
            var t = document.getElementById('visitor-today');
            var a = document.getElementById('visitor-total');
            if (t && data.today != null) t.textContent = Number(data.today).toLocaleString('ko-KR');
            if (a && data.total != null) a.textContent = Number(data.total).toLocaleString('ko-KR');
          })
          .catch(function () {});
      })();
    </script>
  </body>
</html>
