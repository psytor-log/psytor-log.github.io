---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  formatKoreanDateTime,
  getMachineDateTime,
  getPostDateValue,
  getPostThumbnail,
  getReadingTime
} from '../utils/posts.js';

const modules = import.meta.glob('../../content/{essay,study,books,portfolio}/*.md', { eager: true });
const rawModules = import.meta.glob('../../content/{essay,study,books,portfolio}/*.md', {
  eager: true,
  query: '?raw',
  import: 'default'
});
const posts = Object.entries(modules)
  .map(([path, mod]) => {
    const category = path.split('/').at(-2);
    const slug = path.split('/').at(-1).replace(/\.md$/, '');
    const frontmatter = mod.frontmatter ?? {};
    const raw = rawModules[path] ?? '';
    return {
      ...frontmatter,
      category,
      slug,
      url: `/${category}/${slug}/`,
      displayDate: formatKoreanDateTime(frontmatter.date),
      machineDate: getMachineDateTime(frontmatter.date),
      thumbnail: getPostThumbnail(frontmatter, raw),
      readingTime: getReadingTime(raw)
    };
  })
  .filter((post) => !post.draft)
  .sort((a, b) => getPostDateValue(b.date) - getPostDateValue(a.date));

const featured = posts[0];
const rest = posts.slice(1, 9);

const homeModules = import.meta.glob('../../content/pages/home.md', { eager: true });
const homeEntry = Object.values(homeModules)[0] ?? {};
const home = homeEntry.frontmatter ?? {};

const heroEyebrow = home.hero_eyebrow ?? 'Thinking Log';
const heroTitle = home.hero_title ?? 'What I Think';
const heroLead = home.hero_lead ?? '생각, 공부, 독서, 프로젝트를 Markdown으로 쌓아 두는 개인 홈페이지입니다.';

const categories = (home.categories && home.categories.length)
  ? home.categories
  : [
      { key: 'essay', name: 'Essay', description: '생각, 관찰, 일과 삶의 기록', href: '/essay/' },
      { key: 'study', name: 'Study', description: '공부한 개념과 도구 정리', href: '/study/' },
      { key: 'books', name: 'Books', description: '읽은 책과 남은 문장', href: '/books/' },
      { key: 'portfolio', name: 'Portfolio', description: '만든 것과 실험 기록', href: '/portfolio/' }
    ];

const featuredLabel = home.section_featured_label ?? 'Latest';
const recentLabel = home.section_recent_label ?? 'Recent';
const viewAllLabel = home.section_view_all_label ?? 'View all  →';
const viewAllHref = home.section_view_all_href ?? '/essay/';
const readTemplate = home.read_button_label_template ?? 'Read {category}  →';

const readButtonLabel = featured
  ? readTemplate.replace('{category}', featured.category)
  : '';
---

<BaseLayout current="home">
  <section class="hero">
    <p class="eyebrow">{heroEyebrow}</p>
    <h1>{heroTitle}</h1>
    <p class="lead">{heroLead}</p>
    <div class="category-grid">
      {categories.map((c) => (
        <a class="category-link" data-cat={c.key} href={c.href}>
          <strong>{c.name}</strong>
          <span>{c.description}</span>
        </a>
      ))}
    </div>
  </section>

  {featured && (
    <section class="featured-strip">
      <div class="featured-strip-head">
        <p class="eyebrow">{featuredLabel}</p>
        <div class="rule"></div>
      </div>
      <article class="featured-card">
        <a class="thumb" href={featured.url} aria-label={`${featured.title} thumbnail`}>
          {featured.thumbnail ? (
            <img src={featured.thumbnail} alt="" loading="lazy" />
          ) : (
            <span class="thumb-placeholder" />
          )}
        </a>
        <div class="featured-body">
          <div class="post-meta-row">
            <span class="cat-badge" data-cat={featured.category}>{featured.category}</span>
            <span class="read-time">{featured.readingTime} min read</span>
          </div>
          <h2 class="featured-title"><a href={featured.url}>{featured.title}</a></h2>
          {featured.summary && <p class="featured-summary">{featured.summary}</p>}
          <p class="featured-meta">
            <time datetime={featured.machineDate}>{featured.displayDate}</time>
          </p>
          <a class="read-btn" href={featured.url}>{readButtonLabel}</a>
        </div>
      </article>
    </section>
  )}

  <div class="section-head">
    <p class="eyebrow">{recentLabel}</p>
    <div class="rule"></div>
    <a class="view-all" href={viewAllHref}>{viewAllLabel}</a>
  </div>
  <section class="post-list">
    {rest.map((post) => (
      <article class={`post-item ${post.thumbnail ? 'has-thumbnail' : ''}`}>
        <time class="post-date" datetime={post.machineDate}>{post.displayDate}</time>
        {post.thumbnail && (
          <a class="post-thumb" href={post.url} aria-label={`${post.title} thumbnail`}>
            <img src={post.thumbnail} alt="" loading="lazy" />
          </a>
        )}
        <div class="post-body">
          <div class="post-meta-row">
            <span class="cat-badge" data-cat={post.category}>{post.category}</span>
            <span class="read-time">{post.readingTime} min read</span>
          </div>
          <h3 class="post-title"><a href={post.url}>{post.title}</a></h3>
          {post.summary && <p class="summary">{post.summary}</p>}
          <div class="tag-row">
            {(post.tags ?? []).map((tag) => <span class="tag">{tag}</span>)}
          </div>
        </div>
      </article>
    ))}
  </section>
</BaseLayout>
