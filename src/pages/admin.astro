<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable.min.css"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Serif+KR:wght@500;600;700&family=Public+Sans:wght@400;500;600;700&family=Source+Serif+Pro:wght@400;600;700&display=swap"
    />
    <link
      href="/admin/config.yml?v=20260603-0024"
      type="text/yaml"
      rel="cms-config-url"
    />
    <title>What I Think Editor</title>
    <style is:global>
      /* Modern Editorial v4 (Cool White / Cobalt) — 미리보기 페인은 사이트(라이트)를
         그대로 반영하고(preview.css), 에디터 크롬도 동일 토큰으로 라이트 코발트. */
      :root {
        --wit-bg: #fbfbfc;
        --wit-surface: #ffffff;
        --wit-surface-soft: #f1f2f5;
        --wit-line: #e7e9ee;
        --wit-line-strong: #d4d8e0;
        --wit-text: #16181d;
        --wit-ink-soft: #3d414b;
        --wit-muted: #5b5f6a;
        --wit-accent: #2563eb;
        --wit-accent-ink: #1d4ed8;
        --wit-accent-soft: #e7efff;
        --wit-serif: "Source Serif Pro", "Noto Serif KR", Georgia,
          "Apple SD Gothic Neo", "Malgun Gothic", serif;
        --wit-sans: "Public Sans", "Pretendard Variable", Pretendard, "Noto Sans KR",
          ui-sans-serif, system-ui, -apple-system, "Segoe UI", "Apple SD Gothic Neo",
          "Malgun Gothic", sans-serif;
      }

      html, body { background: var(--wit-bg); }
      body {
        font-family: var(--wit-sans);
        color: var(--wit-text);
        -webkit-font-smoothing: antialiased;
      }

      /* Top app bar tint to match the warm-paper site */
      [class*="AppHeader"] {
        background: color-mix(in srgb, var(--wit-bg) 86%, white) !important;
        border-bottom: 1px solid var(--wit-line) !important;
      }

      /* Title in the entry editor — best-effort selector */
      [class*="EntryEditor"] input[type="text"][class*="title" i],
      [class*="EditorControlPane"] textarea[id*="title" i],
      [class*="EditorControlPane"] input[id*="title" i] {
        font-family: var(--wit-serif) !important;
        font-size: 1.6rem !important;
        font-weight: 600 !important;
        letter-spacing: -0.015em !important;
        line-height: 1.2 !important;
        color: var(--wit-text) !important;
      }

      /* Sidebar / nav accents (best-effort across Decap class names) */
      a[class*="SidebarNavLink"][class*="active"],
      a[class*="NavLink"][class*="active"] {
        color: var(--wit-accent) !important;
        background: var(--wit-accent-soft) !important;
        border-left: 3px solid var(--wit-accent) !important;
        font-weight: 600 !important;
      }

      /* Buttons */
      button[class*="primary"],
      button[class*="Primary"] {
        background-color: var(--wit-accent) !important;
        border-color: var(--wit-accent) !important;
        border-radius: 8px !important;
      }
      button[class*="primary"]:hover,
      button[class*="Primary"]:hover {
        background-color: var(--wit-accent-ink) !important;
        border-color: var(--wit-accent-ink) !important;
      }

      /* Field labels: small caps */
      label[class*="ControlContainer"] > [class*="Label"],
      label[class*="FieldLabel"] {
        text-transform: uppercase !important;
        letter-spacing: 0.13em !important;
        font-size: 0.72rem !important;
        color: var(--wit-muted) !important;
        font-weight: 700 !important;
      }

      [class*="EditorControlPane"] select[id*="category"],
      [class*="EditorControlPane"] select[name*="category"] {
        border-color: color-mix(in srgb, var(--wit-accent) 42%, var(--wit-line)) !important;
        background: var(--wit-accent-soft) !important;
        color: var(--wit-text) !important;
        font-weight: 700 !important;
      }

      [class*="MarkdownControl"] textarea,
      [class*="MarkdownControl"] [contenteditable="true"] {
        line-height: 1.9 !important;
      }

      /* Keyboard focus visibility inside the editor chrome */
      a:focus-visible,
      button:focus-visible,
      input:focus-visible,
      textarea:focus-visible {
        outline: 2px solid var(--wit-accent) !important;
        outline-offset: 2px !important;
      }

      @media (prefers-reduced-motion: reduce) {
        * { transition-duration: 0.001ms !important; animation-duration: 0.001ms !important; }
      }
    </style>
  </head>
  <body>
    <!--
      Backend status false-alarm guard.
      Decap's GitHub backend polls https://www.githubstatus.com/api/v2/components.json
      and only treats the backend as healthy when BOTH "Git Operations" and
      "API Requests" report exactly "operational". When GitHub posts a mere
      "degraded_performance" (slow but working — commits still succeed), Decap
      fires the recurring "백엔드 서비스 장애" toast. This patch relaxes only
      degraded_performance -> operational for that one status endpoint, so the
      false alarm stops. Genuine partial_outage / major_outage are left intact
      and still surface. Must run before decap-cms.js so the first poll is wrapped.
    -->
    <script is:inline>
      (function () {
        const STATUS_HOST = 'githubstatus.com/api/v2/components.json';
        const nativeFetch = window.fetch ? window.fetch.bind(window) : null;
        if (!nativeFetch) return;
        window.fetch = function (input, init) {
          const url = typeof input === 'string' ? input : (input && input.url) || '';
          const pending = nativeFetch(input, init);
          if (url.indexOf(STATUS_HOST) === -1) return pending;
          return pending
            .then(function (res) {
              return res
                .clone()
                .json()
                .then(function (data) {
                  if (data && Array.isArray(data.components)) {
                    data.components = data.components.map(function (c) {
                      if (c && c.status === 'degraded_performance') {
                        const relaxed = Object.assign({}, c, { status: 'operational' });
                        return relaxed;
                      }
                      return c;
                    });
                  }
                  return new Response(JSON.stringify(data), {
                    status: res.status,
                    statusText: res.statusText,
                    headers: { 'Content-Type': 'application/json' }
                  });
                })
                .catch(function () {
                  return res;
                });
            })
            .catch(function (err) {
              throw err;
            });
        };
      })();
    </script>
    <script is:inline src="https://unpkg.com/decap-cms@3.12.2/dist/decap-cms.js"></script>
    <script is:inline>
      const escapeAttribute = (value = '') =>
        String(value)
          .replace(/&/g, '&amp;')
          .replace(/"/g, '&quot;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;');

      const escapeText = (value = '') =>
        String(value)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;');

      const preserveExtraBlankLinesInText = (text = '') =>
        String(text).replace(/\n{3,}/g, function (match) {
          const spacerCount = Math.max(1, match.length - 2);
          const spacers = Array.from({ length: spacerCount }, function () {
            return '<div class="cms-spacer cms-spacer--1" aria-hidden="true"></div>';
          }).join('\n');
          return '\n\n' + spacers + '\n\n';
        });

      const preserveExtraBlankLines = (body = '') =>
        String(body)
          .split(/(```[\s\S]*?```|~~~[\s\S]*?~~~)/g)
          .map(function (part, index) {
            return index % 2 === 1 ? part : preserveExtraBlankLinesInText(part);
          })
          .join('');

      /* ===== Sized image editor component (preserved from existing code) ===== */
      CMS.registerEditorComponent({
        id: 'sized-image',
        label: 'Image',
        fields: [
          { name: 'src', label: 'Image file', widget: 'image' },
          { name: 'alt', label: 'Alt text', widget: 'string', required: false },
          { name: 'caption', label: 'Caption', widget: 'string', required: false },
          {
            name: 'width',
            label: 'Width',
            widget: 'select',
            default: '100',
            options: [
              { label: 'Small 40%', value: '40' },
              { label: 'Medium 60%', value: '60' },
              { label: 'Large 80%', value: '80' },
              { label: 'Full 100%', value: '100' }
            ]
          },
          {
            name: 'align',
            label: 'Alignment',
            widget: 'select',
            default: 'center',
            options: [
              { label: 'Left', value: 'left' },
              { label: 'Center', value: 'center' },
              { label: 'Right', value: 'right' }
            ]
          }
        ],
        pattern:
          /^<figure class="cms-image cms-image--(left|center|right)" style="--image-width: ([0-9]+)%;">\n  <img src="([^"]*)" alt="([^"]*)" \/>(?:\n  <figcaption>([\s\S]*?)<\/figcaption>)?\n<\/figure>$/,
        fromBlock(match) {
          return {
            align: match[1],
            width: match[2],
            src: match[3],
            alt: match[4],
            caption: match[5] || ''
          };
        },
        toBlock(data) {
          const align = ['left', 'center', 'right'].includes(data.align) ? data.align : 'center';
          const width = ['40', '60', '80', '100'].includes(data.width) ? data.width : '100';
          const caption = data.caption
            ? `\n  <figcaption>${escapeText(data.caption)}</figcaption>`
            : '';

          return `<figure class="cms-image cms-image--${align}" style="--image-width: ${width}%;">\n  <img src="${escapeAttribute(data.src)}" alt="${escapeAttribute(data.alt)}" />${caption}\n</figure>`;
        },
        toPreview(data, getAsset) {
          const align = ['left', 'center', 'right'].includes(data.align) ? data.align : 'center';
          const width = ['40', '60', '80', '100'].includes(data.width) ? data.width : '100';
          const caption = data.caption
            ? `<figcaption>${escapeText(data.caption)}</figcaption>`
            : '';
          // Resolve src through getAsset so newly uploaded (not yet committed)
          // images render as the blob URL Decap holds in memory. Without this,
          // the preview <img> requests the future public path, which 404s
          // until Save → commit → deploy lands the file on the live server.
          let resolvedSrc = data.src || '';
          if (getAsset && data.src) {
            try {
              const asset = getAsset(data.src);
              if (asset) resolvedSrc = asset.toString();
            } catch (_) { /* fall back to raw path */ }
          }

          return `<figure class="cms-image cms-image--${align}" style="--image-width: ${width}%;">\n  <img src="${escapeAttribute(resolvedSrc)}" alt="${escapeAttribute(data.alt)}" />${caption}\n</figure>`;
        }
      });

      CMS.registerEditorComponent({
        id: 'line-space',
        label: 'Blank line',
        fields: [
          {
            name: 'size',
            label: 'Spacing',
            widget: 'select',
            default: '1',
            options: [
              { label: 'One line', value: '1' },
              { label: 'Two lines', value: '2' },
              { label: 'Three lines', value: '3' }
            ]
          }
        ],
        pattern: /^<div class="cms-spacer cms-spacer--([123])" aria-hidden="true"><\/div>$/,
        fromBlock(match) {
          return { size: match[1] || '1' };
        },
        toBlock(data) {
          const size = ['1', '2', '3'].includes(data.size) ? data.size : '1';
          return `<div class="cms-spacer cms-spacer--${size}" aria-hidden="true"></div>`;
        },
        toPreview(data) {
          const size = ['1', '2', '3'].includes(data.size) ? data.size : '1';
          return `<div class="cms-spacer cms-spacer--${size}" aria-hidden="true"></div>`;
        }
      });

      if (CMS.registerEventListener) {
        CMS.registerEventListener({
          name: 'preSave',
          handler: function ({ entry }) {
            const data = entry && entry.get && entry.get('data');
            const body = data && data.get && data.get('body');
            if (typeof body !== 'string') return entry;
            return entry.set('data', data.set('body', preserveExtraBlankLines(body)));
          }
        });
      }

      /* ===== Live preview styling — matches the site ===== */
      CMS.registerPreviewStyle('/admin/preview.css');

      /* ===== Preview template that mirrors src/pages/[category]/[slug].astro ===== */
      const h = CMS.h;
      const createClass = CMS.createClass;

      const formatPreviewDate = (raw) => {
        if (!raw) return '';
        const d = new Date(raw);
        if (Number.isNaN(d.valueOf())) return String(raw);
        const pad = (n) => String(n).padStart(2, '0');
        return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())} ${pad(d.getHours())}:${pad(d.getMinutes())} KST`;
      };

      const readingMinutes = (text = '') => {
        if (!text) return 1;
        const stripped = String(text)
          .replace(/<[^>]+>/g, ' ')
          .replace(/```[\s\S]*?```/g, '')
          .replace(/`[^`]*`/g, '');
        const koreanChars = (stripped.match(/[가-힯]/g) || []).length;
        const englishWords = (stripped.match(/[A-Za-z0-9]+/g) || []).length;
        return Math.max(1, Math.round(koreanChars / 500 + englishWords / 220));
      };

      const postCategories = ['essay', 'study', 'books', 'portfolio'];
      const normalizePreviewCategory = (value, fallback) =>
        postCategories.includes(value) ? value : fallback;

      const buildPostPreview = (fallbackCategory) =>
        createClass({
          render: function () {
            const entry = this.props.entry;
            const data = entry.get('data');
            const category = normalizePreviewCategory(data.get('category'), fallbackCategory);
            const title = data.get('title') || '(제목 없음)';
            const summary = data.get('summary') || '';
            const cover = this.props.getAsset
              ? (data.get('cover') ? this.props.getAsset(data.get('cover')) : null)
              : null;
            const tagsField = data.get('tags');
            const tags = tagsField && tagsField.toJS ? tagsField.toJS() : [];
            const draft = data.get('draft');
            const status = draft ? 'draft' : 'published';
            const dateText = formatPreviewDate(data.get('date'));
            const rawBody = data.get('body') || '';
            const minutes = readingMinutes(rawBody);

            return h(
              'article',
              { className: 'wit-preview' },
              h(
                'p',
                { className: 'eyebrow', 'data-cat': category },
                category.toUpperCase() + ' · ' + minutes + ' MIN READ',
                h(
                  'span',
                  { className: 'status', 'data-state': status },
                  draft ? 'DRAFT' : 'PUBLISHED'
                )
              ),
              h('h1', null, title),
              summary
                ? h('p', { className: 'lead' }, summary)
                : null,
              h(
                'p',
                { className: 'meta' },
                (dateText ? dateText + '  /  ' : '') + category
              ),
              tags && tags.length
                ? h(
                    'div',
                    { className: 'tag-row' },
                    tags.map(function (t, i) {
                      return h('span', { className: 'tag', key: 'tag-' + i }, t);
                    })
                  )
                : null,
              cover
                ? h('img', { className: 'cover', src: cover.toString(), alt: '' })
                : null,
              h('div', { className: 'body' }, this.props.widgetFor('body'))
            );
          }
        });

      CMS.registerPreviewTemplate('essay', buildPostPreview('essay'));
      CMS.registerPreviewTemplate('study', buildPostPreview('study'));
      CMS.registerPreviewTemplate('books', buildPostPreview('books'));
      CMS.registerPreviewTemplate('portfolio', buildPostPreview('portfolio'));

      /* ===== About page preview ===== */
      CMS.registerPreviewTemplate(
        'about',
        createClass({
          render: function () {
            const entry = this.props.entry;
            const data = entry.get('data');
            const title = data.get('title') || 'About';
            const summary = data.get('summary') || '';
            const eyebrow = data.get('eyebrow') || 'About';
            return h(
              'article',
              { className: 'wit-preview' },
              h('p', { className: 'eyebrow' }, eyebrow),
              h('h1', null, title),
              summary ? h('p', { className: 'lead' }, summary) : null,
              h('div', { className: 'body' }, this.props.widgetFor('body'))
            );
          }
        })
      );

      /* ===== Site (global text) preview ===== */
      CMS.registerPreviewTemplate(
        'site',
        createClass({
          render: function () {
            const data = this.props.entry.get('data');
            const brand = data.get('brand') || 'What I Think';
            const menu = data.get('menu');
            const footer = data.get('footer');
            const menuItems = menu
              ? ['home', 'essay', 'study', 'books', 'portfolio', 'about'].map(function (k) {
                  return { key: k, label: menu.get(k) || k };
                })
              : [];
            return h(
              'article',
              { className: 'wit-preview' },
              h('p', { className: 'eyebrow' }, 'SITE · NAV PREVIEW'),
              h('h1', null, brand),
              h(
                'div',
                {
                  style: {
                    display: 'flex',
                    gap: '14px',
                    flexWrap: 'wrap',
                    padding: '14px 0',
                    borderTop: '1px solid #e7e9ee',
                    borderBottom: '1px solid #e7e9ee',
                    margin: '18px 0'
                  }
                },
                menuItems.map(function (m, i) {
                  return h(
                    'span',
                    {
                      key: 'm-' + i,
                      style: { color: '#5b5f6a', fontWeight: 600 }
                    },
                    m.label
                  );
                })
              ),
              footer
                ? h(
                    'div',
                    {
                      style: {
                        padding: '18px',
                        background: '#ffffff',
                        border: '1px solid #e7e9ee',
                        borderRadius: '8px'
                      }
                    },
                    h(
                      'p',
                      { style: { margin: 0, fontWeight: 700 } },
                      footer.get('brand') || brand
                    ),
                    h(
                      'p',
                      { style: { margin: '4px 0 14px', color: '#5b5f6a', fontSize: '0.86rem' } },
                      footer.get('tagline') || ''
                    ),
                    h(
                      'div',
                      { style: { display: 'flex', gap: '14px', alignItems: 'center', fontSize: '0.82rem', color: '#5b5f6a' } },
                      h('span', null, footer.get('admin_label') || '/admin/'),
                      h('span', null, (footer.get('today_label') || 'Today') + ': 0'),
                      h('span', null, (footer.get('total_label') || 'Total') + ': 0')
                    )
                  )
                : null
            );
          }
        })
      );

      /* ===== Home page preview ===== */
      CMS.registerPreviewTemplate(
        'home',
        createClass({
          render: function () {
            const data = this.props.entry.get('data');
            const eyebrow = data.get('hero_eyebrow') || 'Thinking Log';
            const title = data.get('hero_title') || 'What I Think';
            const lead = data.get('hero_lead') || '';
            const categoriesList = data.get('categories');
            const categories =
              categoriesList && categoriesList.toJS ? categoriesList.toJS() : [];
            return h(
              'article',
              { className: 'wit-preview' },
              h('p', { className: 'eyebrow' }, eyebrow),
              h('h1', null, title),
              lead ? h('p', { className: 'lead' }, lead) : null,
              categories.length
                ? h(
                    'div',
                    {
                      style: {
                        display: 'grid',
                        gridTemplateColumns: 'repeat(2, minmax(0, 1fr))',
                        gap: '12px',
                        marginTop: '20px'
                      }
                    },
                    categories.map(function (c, i) {
                      const colorMap = {
                        essay: '#2563eb',
                        study: '#0f766e',
                        books: '#a16207',
                        portfolio: '#6d28d9'
                      };
                      const stripe = colorMap[c.key] || '#2563eb';
                      return h(
                        'div',
                        {
                          key: 'c-' + i,
                          style: {
                            position: 'relative',
                            padding: '16px 16px 16px 22px',
                            border: '1px solid #e7e9ee',
                            borderRadius: '8px',
                            background: '#ffffff'
                          }
                        },
                        h('span', {
                          style: {
                            position: 'absolute',
                            left: 0,
                            top: 0,
                            bottom: 0,
                            width: '4px',
                            background: stripe
                          }
                        }),
                        h(
                          'strong',
                          { style: { display: 'block', marginBottom: '4px' } },
                          c.name
                        ),
                        h(
                          'span',
                          { style: { color: '#5b5f6a', fontSize: '0.88rem' } },
                          c.description
                        )
                      );
                    })
                  )
                : h('p', { className: 'empty' }, '(카테고리 박스 없음)'),
              h(
                'div',
                {
                  style: {
                    marginTop: '28px',
                    padding: '14px',
                    border: '1px dashed #e7e9ee',
                    borderRadius: '8px',
                    color: '#5b5f6a',
                    fontSize: '0.86rem'
                  }
                },
                'Featured/Recent 카드의 실제 데이터는 글 콘텐츠에서 채워집니다. 여기서는 라벨만 미리보기 합니다: ',
                h(
                  'span',
                  { style: { color: '#2563eb', fontWeight: 700 } },
                  (data.get('section_featured_label') || 'Latest') +
                    '  /  ' +
                    (data.get('section_recent_label') || 'Recent') +
                    '  /  ' +
                    (data.get('section_view_all_label') || 'View all  →')
                )
              )
            );
          }
        })
      );
    </script>
  </body>
</html>
