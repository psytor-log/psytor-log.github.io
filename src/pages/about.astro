---
import BaseLayout from '../layouts/BaseLayout.astro';

const modules = import.meta.glob('../../content/pages/about.md', { eager: true });
const about = Object.values(modules)[0];
const { frontmatter } = about;
const Content = about.Content;
---

<BaseLayout
  title={`${frontmatter.title} | What I Think`}
  description={frontmatter.summary}
  current="about"
>
  <article class="article">
    <header class="article-header">
      <p class="eyebrow">{frontmatter.eyebrow}</p>
      <h1>{frontmatter.title}</h1>
      <p class="lead">{frontmatter.summary}</p>
    </header>
    <div class="article-content">
      <Content />
    </div>
  </article>
</BaseLayout>
