---
import BaseLayout from '../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  const modules = import.meta.glob('../../../content/{essay,study,books,portfolio}/*.md', { eager: true });
  return Object.entries(modules).map(([path, mod]) => {
    const category = path.split('/').at(-2);
    const slug = path.split('/').at(-1).replace(/\.md$/, '');
    return {
      params: { category, slug },
      props: { post: mod, frontmatter: mod.frontmatter, category }
    };
  });
}

const { post, frontmatter, category } = Astro.props;
const Content = post.Content;
---

<BaseLayout title={`${frontmatter.title} | What I Think`} description={frontmatter.summary} current={category}>
  <article class="article">
    <header class="article-header">
      <p class="article-meta">{frontmatter.date} · {category}</p>
      <h1>{frontmatter.title}</h1>
      <p class="lead">{frontmatter.summary}</p>
      <div class="tag-row">
        {(frontmatter.tags ?? []).map((tag) => <span class="tag">{tag}</span>)}
      </div>
    </header>
    {frontmatter.cover && <img class="cover" src={frontmatter.cover} alt="" />}
    <div class="article-content">
      <Content />
    </div>
  </article>
</BaseLayout>
